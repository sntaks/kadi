<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The suite outgrew PHP's 128M default in one process. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="MAIL_FROM_ADDRESS" value="hello@example.com"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="SENTRY_DSN" value=""/>
        <env name="SENTRY_ENABLE_LOGS" value="false"/>
        <!-- Platform switches start off whatever the local .env says; tests that need one turn it on. -->
        <env name="PLATFORM_TOKEN_LAUNCH" value="true"/>
        <env name="PLATFORM_DEEP_LINK" value="true"/>
        <env name="PLATFORM_SPORTS" value="true"/>
        <env name="ODDS_API_MARKETS" value="h2h,totals,spreads"/>
        <env name="ODDS_API_BASKETBALL_MARKETS" value="h2h,totals"/>
        <env name="ODDS_API_ICEHOCKEY_MARKETS" value="h2h,totals"/>
        <env name="ODDS_API_BOOKMAKERS" value=""/>
        <env name="ODDS_API_SPREADS_BOOKMAKERS" value="pinnacle,onexbet,marathonbet,mybookieag,bovada,coolbet,betonlineag,lowvig,betus"/>
        <!-- Throwaway test keys for encrypt_account_id(); never the real pair. -->
        <env name="GAMES_ACCOUNT_ID_KEY" value="6f23fa26063697ed59d279a088c8ed86a636aaaf0d577a72f5528a3569a8ec0d"/>
        <env name="GAMES_ACCOUNT_ID_MAC_KEY" value="c9b81c85ad08bfe489a9766ab5a6ef4065a6d7d27a1b379b5e18e34a1ad804aa"/>
        <env name="PLATFORM_SPORTS_BETTING" value="true"/>
        <env name="PLATFORM_PREDICTIONS" value="true"/>
        <env name="PLATFORM_PREDICTIONS_BETTING" value="true"/>
        <env name="PREDICT_BETTING_TESTERS" value=""/>
        <env name="KADI_IN_FRAME" value="true"/>
    </php>
</phpunit>
