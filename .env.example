APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Shared KadiApi customer-ID encryption key (AES-256-GCM). REQUIRED outside local.
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# Must match the key configured on the KadiApi service; rotate on both sides together.
OPENSSL_KEY=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# One signed-in device per player (docs/single-session.md); needs the database session driver.
AUTH_SINGLE_SESSION=true
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Reverb (real-time broadcasting, e.g. instant wallet balance updates). See docs/wallet-webhook.md.
# Generate app id/key/secret per environment (php artisan reverb:install, or your own random values).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# PHP -> Reverb (server-to-server publish). Internal only, never proxied or exposed publicly.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Where Reverb actually binds/listens (reverb:start). Loopback only; Apache proxies to it in production.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Browser -> Reverb, proxied on the public domain (Apache, mod_proxy_wstunnel). See docs/wallet-webhook.md.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=kadi.online
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# WebAuthn passkeys (Fortify). Secret used to derive per-user WebAuthn user handles.
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# Rotating this invalidates all registered passkeys.
PASSKEYS_USER_HANDLE_SECRET=

# External Kadi play site linked from the dashboard.
KADI_PLAY_URL=https://kadi.online

# Operator details on /terms and /privacy (config/kadi.php "legal"). Blank lines are hidden.
KADI_LEGAL_OPERATOR="Kizuka Na Michezo Limited"
KADI_LEGAL_ADDRESS=
KADI_LICENCE_NUMBER=

# Customer care (config/kadi.php "support"): footer, FAQ, legal pages. Phone in local form 0XXXXXXXXX.
KADI_SUPPORT_PHONE=0182473265
KADI_SUPPORT_EMAIL=kadiapponline@gmail.com
KADI_SUPPORT_WHATSAPP=https://wa.me/kadi.OnlineKE

# M-Pesa Pay Bill number shown to players (wallet, sportsbook, home, FAQ) for loading their wallet
# by hand, with their account_no as the account number. Display only: STK push uses MPESA_C2B_SHORTCODE.
MPESA_SHORTCODE=4007279

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX) and Search Console
# HTML-tag verification code. Leave blank to disable both.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

VITE_APP_NAME="${APP_NAME}"

# Web Push (PWA notifications). Generate the key pair once per environment with:
#   php artisan webpush:vapid
# On Windows/Herd, generating keys needs OPENSSL_CONF pointing at your PHP openssl.cnf (only for
# `webpush:vapid`; sending pushes works without it). See docs/pwa-push.md.
# Never share or commit the private key; rotating it invalidates every existing subscription.
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push API (server-to-server: lets the game server send push notifications to players).
# See docs/push-api.md. Generate a key with `php artisan push-api:key` and put ONLY its hash here.
# Empty means the API is disabled (every request is refused). Two comma-separated hashes = key rotation.
PUSH_API_KEY_HASHES=
# Optional: only these caller IPs may use it (comma separated). Empty = any IP with a valid key.
PUSH_API_ALLOWED_IPS=
# The API may send `urgency: high` (delivered to sleeping phones at once). Set to false to refuse it.
PUSH_API_ALLOW_HIGH_URGENCY=true
# System-wide broadcasts to every registered device use a SEPARATE key (generate with `php artisan push-api:key --broadcast`).
# Empty disables broadcasts. Caps: PUSH_API_BROADCAST_PER_HOUR (per key, default 6), PUSH_API_BROADCAST_PER_DAY (total, default 4).
PUSH_API_BROADCAST_KEY_HASHES=
# Optional: send broadcasts on their own queue (needs a worker on it, see docs/push-api.md). Empty = the default queue.
PUSH_API_BROADCAST_QUEUE=

# Wallet webhook (KadiApi -> this site: pushes wallet balance changes). See docs/wallet-webhook.md.
# Raw shared secret(s), comma separated (list two while rotating). Empty means the endpoint is disabled.
KADI_WALLET_WEBHOOK_SECRETS=
# GMS (staff back office) signs its calls to /api/v1/backoffice with one of these (comma separated, for rotation).
# Generate with: php -r "echo bin2hex(random_bytes(32));". Empty refuses every call. Never logged.
BACKOFFICE_GMS_SECRETS=

# Game history and disputes (see docs/game-disputes.md). KadiApi path for a player's latest 10 games of each kind.
KADI_PLAYED_GAMES_ENDPOINT=

# Phone verification codes by SMS through TextSMS (see docs/phone-verification.md).
# Never commit the API key; it lives in .env only.
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=TextSMS

# Referrals "Invite & Earn" (see docs/referrals.md). false hides the page and stops ?ref capture.
KADI_REFERRALS_ENABLED=true
KADI_PROMOTIONS_ENABLED=true
KADI_GAME_API_URL=https://gameapi.kadi.online/kadi
KADI_PROMO_JACKPOT_TYPE=BRONZE
KADI_PROMO_JACKPOT_AMOUNT=20

# Sentry (error monitoring + tracing). Leave the DSN empty to disable.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Sends Laravel logs to Sentry Logs; also add sentry_logs to LOG_STACK (e.g. LOG_STACK=single,sentry_logs).
SENTRY_ENABLE_LOGS=false
SENTRY_LOG_LEVEL=warning
# SENTRY_ENVIRONMENT defaults to APP_ENV; SENTRY_RELEASE defaults to the deployed git commit.
SENTRY_RELEASE=
# Browser SDK (resources/js/sentry.js), baked in at `npm run build`.
VITE_SENTRY_DSN="${SENTRY_LARAVEL_DSN}"
VITE_SENTRY_ENVIRONMENT="${APP_ENV}"
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
# Optional: uploads source maps during `npm run build` when set (never commit it).
SENTRY_AUTH_TOKEN=

# Switches for parts of the site (config/platform.php). On by default except PLATFORM_SPORTS_BETTING (real money),
# which each environment turns on deliberately. Set one to false to take that part away.
PLATFORM_TOKEN_LAUNCH=true
PLATFORM_DEEP_LINK=true
PLATFORM_SPORTS=true
PLATFORM_SPORTS_BETTING=true
# In-play prices (plan §5): off until the soft launch.
PLATFORM_SPORTS_IN_PLAY=false
PLATFORM_PREDICTIONS=true
PLATFORM_PREDICTIONS_BETTING=true
# User ids that may place prediction bets while PLATFORM_PREDICTIONS_BETTING is off (staff checks before opening).
PREDICT_BETTING_TESTERS=

# The merged sportsbook (config/sportsbook.php). "replay" serves the recordings in database/sportsbook and never
# spends Odds API credits; "live" needs ODDS_API_KEY.
ODDS_API_DRIVER=replay
ODDS_API_KEY=
ODDS_API_REGION=uk
ODDS_API_MARKETS=h2h,totals,spreads
ODDS_API_BASKETBALL_MARKETS=h2h,totals
ODDS_API_ICEHOCKEY_MARKETS=h2h,totals
ODDS_API_MONTHLY_CREDIT_CAP=100000
ODDS_API_CREDIT_RESERVE=2000
# Per-purpose monthly allowances (plan §10.2); the rest of the cap is headroom.
ODDS_API_ALLOWANCE_PRE_MATCH=9000
ODDS_API_ALLOWANCE_PER_EVENT=6000
ODDS_API_ALLOWANCE_LIVE=72000
ODDS_API_ALLOWANCE_SCORES=3000
# Named bookmakers instead of ODDS_API_REGION; each group of 10 costs one region. Empty = use the region.
ODDS_API_BOOKMAKERS=
# Football handicaps come from their own books (the uk region hardly prices them).
ODDS_API_SPREADS_BOOKMAKERS=pinnacle,onexbet,marathonbet,mybookieag,bovada,coolbet,betonlineag,lowvig,betus
# Sports bets are Kadi API wagers (docs/sportsbook-wagers.md). The game key of game `sportsbook`; never logged.
KADI_SPORTSBOOK_GAME_KEY=
# Production: a dedicated queue with its own worker (the scheduler also sends due ops every minute).
SPORTSBOOK_WAGER_QUEUE=default

# Game launches (config/games.php). Kadi plays inside the site's frame like slots and scratch cards;
# false opens Kadi's own page instead (with the launcher on).
KADI_IN_FRAME=true
# Players seated per Kadi mode (landing headliner).
KADI_TOTALS_URL=https://gameapi.kadi.online/kadi/get_user_totals.php
GAMES_LAUNCHES_PER_MINUTE=6
# account_id posted to slot/scratch launches: 64-hex AES-256 key and HMAC key, the same pair the game servers hold.
GAMES_ACCOUNT_ID_KEY=
GAMES_ACCOUNT_ID_MAC_KEY=
